#include <Servo.h>

Servo sailServo;

int LDR1;
int LDR2;

void setup() {
  Serial.begin(9600);
  sailServo.attach(9);
}

void loop() {

  LDR1 = analogRead(A0);
  LDR2 = analogRead(A1);

  int difference = LDR1 - LDR2;

  // dead zone to stop shaking
  if (abs(difference) < 20) {
    sailServo.write(90);   // stay centered
    Serial.println("Stable");
  }

  else if (LDR1 > LDR2) {
    sailServo.write(120);  // turn left
    Serial.println("Turning Left");
  }

  else if (LDR2 > LDR1) {
    sailServo.write(60);   // turn right
    Serial.println("Turning Right");
  }

  delay(100);
}
